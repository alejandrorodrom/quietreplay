{
  "name": "quietreplay",
  "version": "2.1.1",
  "private": true,
  "description": "Record what you do on a Chrome page and save it on your computer. Nothing is sent online.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/classic.spec.ts",
    "test:e2e:external": "playwright test tests/e2e/external.spec.ts",
    "check:no-network": "tsx scripts/check-no-network.ts",
    "check:license-headers": "tsx scripts/check-license-headers.ts",
    "postinstall": "wxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrorodrom/quietreplay.git"
  },
  "author": "Alejandro Rodriguez Romero",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
